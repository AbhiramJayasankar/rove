{
  "name": "rove-browser",
  "version": "2.4.1",
  "private": true,
  "license": "MIT",
  "type": "module",
  "description": "A self-contained Chrome browser agent with your own model endpoint",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "dev": "node scripts/build-extension.mjs --watch",
    "start": "node scripts/build-extension.mjs --watch",
    "build": "tsc --noEmit && node scripts/build-extension.mjs",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:e2e": "playwright test",
    "check": "npm run build && npm test"
  },
  "dependencies": {
    "@cfworker/json-schema": "^4.1.1",
    "lucide-react": "^0.468.0",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "react-markdown": "^10.1.0",
    "remark-gfm": "^4.0.1",
    "zod": "^4.0.0"
  },
  "devDependencies": {
    "@playwright/test": "^1.56.0",
    "@types/chrome": "^0.3.5",
    "@types/node": "^24.0.0",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "@vitejs/plugin-react": "^5.0.0",
    "esbuild": "^0.28.2",
    "typescript": "^5.9.0",
    "vite": "^7.1.0",
    "vitest": "^5.0.5"
  }
}
