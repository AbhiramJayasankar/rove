{
  "manifest_version": 3,
  "name": "Rove",
  "version": "2.5.1",
  "description": "Your browser agent. Your endpoint, prompts, tools and history. Runs entirely in Chrome.",
  "minimum_chrome_version": "125",
  "permissions": ["debugger", "tabs", "tabGroups", "storage", "downloads", "sidePanel", "unlimitedStorage"],
  "host_permissions": ["http://*/*", "https://*/*"],
  "background": { "service_worker": "runtime.js", "type": "module" },
  "side_panel": { "default_path": "index.html" },
  "options_page": "index.html?view=tab",
  "commands": { "_execute_action": { "suggested_key": { "default": "Alt+Shift+O" }, "description": "Open Rove" } },
  "action": { "default_title": "Open Rove", "default_icon": { "16":"icons/16.png", "32":"icons/32.png", "48":"icons/48.png", "128":"icons/128.png" } },
  "icons": { "16":"icons/16.png", "32":"icons/32.png", "48":"icons/48.png", "128":"icons/128.png" },
  "content_security_policy": {
    "extension_pages": "script-src 'self'; object-src 'none'; base-uri 'self'; connect-src https: http:; img-src 'self' data: blob:; style-src 'self' 'unsafe-inline'; frame-ancestors 'none'"
  }
}
